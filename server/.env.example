# M-Pesa API Configuration
# Get these credentials from Safaricom Daraja Portal: https://developer.safaricom.co.ke

# Environment: 'sandbox' for testing, 'production' for live
MPESA_ENV=sandbox

# M-Pesa API Credentials
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Business Short Code (Paybill or Till Number)
MPESA_SHORTCODE=174379

# Passkey from Daraja Portal
MPESA_PASSKEY=your_passkey_here

# Callback URL (must be publicly accessible HTTPS URL)
# For development, use ngrok or similar service: https://yourdomain.com/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# API Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
